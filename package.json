    "e2e": "echo e2e not currently supported",
    "deploy": "node ./node_modules/@angular/cli/bin/ng.js build --configuration production --base-href /tree-d3-demo/ && npx ngh --dir=dist/tree-d3-demo/ --no-silent",
    "deploy2": "node ./node_modules/@angular/cli/bin/ng.js build --configuration=production --base-href /tree-d3-demo-ui/ && npx ngh --dir=dist/tree-d3-demo/ --no-silent --repo=https://GH_TOKEN@github.com/isearch-gp/tree-d3-demo-ui.git"
